# Copy to .env and fill in real values for local dev. Never commit the real .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://sutura:sutura@localhost:5432/sutura
TEST_DATABASE_URL=postgresql+psycopg://sutura:sutura@localhost:5432/sutura_test

# --- JWT / Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- S3-compatible file storage (receipts/attachments) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=sutura-attachments
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_REGION=us-east-1

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
